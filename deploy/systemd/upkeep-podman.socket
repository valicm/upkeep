# /etc/systemd/system/upkeep-podman.socket
#
# How the agent gets to see rootful Podman's containers: a second API socket, of its own,
# that members of the group "upkeep" may use. Podman's own socket (podman.socket) is left
# alone, and would not do: /run/podman is a directory only root may enter.
#
# Know what this gives away. Podman's API has no read-only side: whoever can use this socket
# can start a container that mounts the whole machine. The group "upkeep" is root in all but
# name. The agent only sends GET requests (list and inspect), and its unit takes away what it
# does not need, but the socket itself cannot tell. A machine where that is too much runs
# the agent with "enabled = false" in [containers] and does without the container rows.

[Unit]
Description=Podman API socket for the upkeep agent
Documentation=man:podman-system-service(1)

[Socket]
ListenStream=/run/upkeep-podman/podman.sock
SocketUser=root
SocketGroup=upkeep
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
